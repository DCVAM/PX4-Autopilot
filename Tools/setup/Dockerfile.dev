# Fetch ROS 2 Humble desktop image
FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm \
    TZ=UTC \
    RUNS_IN_DOCKER=true

# SITL UDP ports
EXPOSE 14556/udp
EXPOSE 14557/udp

# Install sudo + basic tools
RUN apt update && apt install -y \
    sudo \
    mesa-utils \
 && rm -rf /var/lib/apt/lists/*

# Create non-root user (UID/GID passed via build args)
ARG UID
ARG GID
RUN groupadd -g ${GID} devgroup \
 && useradd -m -u ${UID} -g ${GID} -s /bin/bash devuser \
 && usermod -aG sudo devuser \
 && echo "devuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/devuser \
 && chmod 0440 /etc/sudoers.d/devuser

# Copy entrypoint
COPY ./docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Install PX4 dependencies
COPY ./requirements.txt /tmp/requirements.txt
COPY ./ubuntu.sh /tmp/ubuntu.sh
RUN bash /tmp/ubuntu.sh

# Make git safe for devuser
RUN git config --global --add safe.directory '*'

# Switch to non-root user
USER devuser
WORKDIR /workspaces

# Auto-source ROS for devuser
RUN echo "source /opt/ros/humble/setup.bash" >> /home/devuser/.bashrc

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
